APP_PORT=8080
APP_ENV=development
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=veloham
DB_SSLMODE=disable
DATABASE_URL=
REDIS_URL=redis://redis:6379/0
JWT_SECRET=local-development-secret-change-before-production
