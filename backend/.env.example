API_BASE_URL=http://127.0.0.1:8080
# Public Vercel frontend origin.
PUBLIC_BASE_URL=http://127.0.0.1:5173
FREEDOMPAY_MERCHANT_ID=
FREEDOMPAY_SECRET=
