# Trusted project checks.
# These rules are intentionally scoped to read-only inspection and the official
# Go vulnerability scanner; destructive commands remain outside the allow-list.

prefix_rule(
    pattern = ["go", "run", "golang.org/x/vuln/cmd/govulncheck@v1.6.0"],
    decision = "allow",
    justification = "Run the project's pinned Go vulnerability scanner without prompting.",
    match = [
        "go run golang.org/x/vuln/cmd/govulncheck@v1.6.0 ./...",
    ],
)

prefix_rule(
    pattern = ["govulncheck"],
    decision = "allow",
    justification = "Run Go vulnerability scans without prompting.",
    match = [
        "govulncheck ./...",
    ],
)

prefix_rule(
    pattern = ["rg"],
    decision = "allow",
    justification = "Search project files without prompting.",
)

prefix_rule(
    pattern = ["sed"],
    decision = "allow",
    justification = "Read project files without prompting.",
)

prefix_rule(
    pattern = ["find"],
    decision = "allow",
    justification = "Inspect project paths without prompting.",
)
